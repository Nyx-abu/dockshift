{
  "name": "dockshift",
  "version": "1.0.0",
  "description": "An open-source floating productivity dock for Windows",
  "main": "electron-main.js",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "dock",
    "ai",
    "productivity",
    "windows"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.43.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.3.9",
    "node-pty": "^1.1.0",
    "re-resizable": "^6.11.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^40.6.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.0.8"
  },
  "build": {
    "appId": "com.shineup.dockshift",
    "productName": "DockShift",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "preload.js",
      "electron-persistence.js",
      "src/workspace/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github"
    }
  }
}
